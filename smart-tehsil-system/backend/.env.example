# Database — use sqlite:///./tehsil.db for local dev, or postgresql://... for prod
DATABASE_URL=sqlite:///./tehsil.db

# JWT
SECRET_KEY=change-this-to-a-long-random-secret-key-before-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Admin default credentials (used only during seed)
ADMIN_EMAIL=admin@tehsil.gov.in
ADMIN_PASSWORD=Admin@123

# File uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# AI Assistant — leave blank to use offline knowledge-base only
# GEMINI_API_KEY=
# OPENAI_API_KEY=

# CORS — comma separated allowed origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# App info
APP_NAME=Smart Tehsil Citizen Service Portal
TEHSIL_NAME=Demo Tehsil
DISTRICT_NAME=Demo District
